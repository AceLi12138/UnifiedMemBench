# UnifiedMemBench environment template.
# Copy this file to `.env` and fill only the providers or local paths you use.

# API model keys used by data generation, dialogue generation, audit/repair,
# contextual evaluation, and LLM-judge scoring.
MIMO_API_KEY=
KIMI_API_KEY=
MOONSHOT_API_KEY=
SILICONFLOW_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional repository and data roots. Prefer passing explicit CLI paths when possible.
UMB_ROOT=
UMB_DATA_DIR=
UMB_OUTPUT_DIR=

# Optional local model / training paths for vLLM and parametric experiments.
MODEL_DIR=
LLAMAFACTORY_ROOT=

# Optional runtime controls.
CUDA_VISIBLE_DEVICES=
TOKENIZERS_PARALLELISM=false
UMB_FIGURE_OUTPUT_DIR=

